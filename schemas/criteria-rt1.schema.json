{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registeredbrands.ai/schemas/criteria-rt1.schema.json",
  "title": "criteria-rt1",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uri"
    },
    "version": {
      "const": 1
    },
    "accepted_mia_issuers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253,
        "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
      }
    },
    "required_checks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "assertion_signature",
          "merchant_domain",
          "merchant_authorization",
          "issuer_trust",
          "identity_evidence",
          "revocation",
          "payment_recipient_binding"
        ]
      },
      "allOf": [
        {
          "contains": {
            "const": "assertion_signature"
          }
        },
        {
          "contains": {
            "const": "merchant_domain"
          }
        },
        {
          "contains": {
            "const": "merchant_authorization"
          }
        },
        {
          "contains": {
            "const": "issuer_trust"
          }
        },
        {
          "contains": {
            "const": "identity_evidence"
          }
        },
        {
          "contains": {
            "const": "revocation"
          }
        }
      ]
    },
    "maximum_evidence_age_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "require_payment_recipient_binding": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "version",
    "accepted_mia_issuers",
    "required_checks",
    "maximum_evidence_age_seconds",
    "require_payment_recipient_binding"
  ],
  "additionalProperties": false
}
