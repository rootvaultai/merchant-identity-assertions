{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registeredbrands.ai/schemas/request-context-rt1.schema.json",
  "title": "request-context-rt1",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "profile": {
      "const": "https://registeredbrands.ai/profiles/mia-runtime/v1"
    },
    "merchant_domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "operation": {
      "enum": [
        "payment",
        "merchant_check"
      ]
    },
    "tool_id": {
      "type": "string",
      "minLength": 1
    },
    "call_id": {
      "type": "string",
      "minLength": 1
    },
    "session_binding": {
      "type": "string",
      "minLength": 1
    },
    "request_nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22,}$"
    },
    "parameters": {
      "type": "object"
    }
  },
  "required": [
    "version",
    "profile",
    "merchant_domain",
    "operation",
    "tool_id",
    "call_id",
    "session_binding",
    "request_nonce",
    "parameters"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "payment"
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "properties": {
              "recipient": {
                "type": "object",
                "properties": {
                  "scheme": {
                    "type": "string",
                    "minLength": 1
                  },
                  "identifier": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "scheme",
                  "identifier"
                ],
                "additionalProperties": false
              },
              "amount_minor": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            },
            "required": [
              "recipient",
              "amount_minor",
              "currency"
            ],
            "additionalProperties": true
          }
        }
      }
    }
  ]
}
